{
  "name": "@alrevion/email-api",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted email on Cloudflare Workers: transactional send API (Brevo → Resend fallback), inbound mail via Email Routing, and a webmail cabinet",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create email-api-db",
    "d1:migrate-remote": "wrangler d1 migrations apply email-api-db --remote",
    "d1:migrate-local": "wrangler d1 migrations apply email-api-db --local",
    "kv:create": "wrangler kv namespace create RATE_LIMIT",
    "kv:create-preview": "wrangler kv namespace create RATE_LIMIT --preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.18",
    "postal-mime": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231218.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "wrangler": "^4.90.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
